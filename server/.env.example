NODE_ENV=development
PORT=5000
# Transactions need a replica set. `npm run db:dev` starts a local single-node replica set on 27018.
MONGO_URI=mongodb://127.0.0.1:27018/fashion_pos?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
BACKUP_DIR=backups
REPORT_TZ=Asia/Kolkata
# Refuse to start without transaction support (recommended in production)
REQUIRE_TRANSACTIONS=false

# No login screen: every visitor is signed in as AUTO_LOGIN_USER. Anyone with the URL gets full access.
AUTH_DISABLED=false
AUTO_LOGIN_USER=admin@marc.com
